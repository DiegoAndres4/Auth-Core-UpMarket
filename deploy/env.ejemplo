# Plantilla de variables para docker compose (AuthCore).
#
# Uso recomendado: ejecuta deploy/generar-env.sh, que crea .env con secretos
# aleatorios. Si copias esta plantilla a mano, cambia TODOS los valores.
# JWT_SECRET debe ser el MISMO que use dominio-service (allí va en Base64).
DB_ROOT_PASSWORD=0123456789abcdef0123456789abcdef
DB_PASSWORD=0123456789abcdef0123456789abcdef
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_PASSWORD=0123456789abcdef01234567
